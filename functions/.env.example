# Configuración de proveedor de correo para enviar plantillas HTML prémium

# Opción A: Resend (Recomendado, gratis en resend.com)
RESEND_API_KEY=re_123456789
FROM_EMAIL=Calculadora de Márgenes <onboarding@resend.dev>
REPLY_TO=sopoterefillstore@gmail.com

# Opción B: SMTP (Gmail, Brevo, SendGrid, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicación

# Verificación automática Pabilo (producción: configurar con `firebase functions:secrets:set`)
# PABILO_API_KEY=tu_api_key_de_pabilo
# PABILO_USER_BANK_ID=id_numerico_de_tu_cuenta_bdv_en_pabilo
# Opcional: si también conectas Binance Pay en Pabilo (o en Firestore config/pabiloPrivate.binanceUserBankId)
# PABILO_BINANCE_USER_BANK_ID=
# PABILO_BASE_URL=https://api.pabilo.app

# Datos públicos opcionales mostrados al usuario si aún no están en Firestore (`config/proPayments`)
# PRO_PM_BANK=Banco de Venezuela
# PRO_PM_CEDULA=V-XXXXXXXX
# PRO_PM_PHONE=04XX-XXXXXXX
# PRO_PM_HOLDER=Titular
# PRO_USDT_NETWORK=Binance Pay / TRC20
# PRO_BINANCE_PAY_ID=
# PRO_USDT_ADDRESS=
# PRO_SUPPORT_EMAIL=
# PRO_SUPPORT_WHATSAPP=
