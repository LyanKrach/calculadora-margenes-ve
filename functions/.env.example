# Configuración de proveedor de correo para enviar plantillas HTML prémium

# Opción A: Resend (Recomendado, gratis en resend.com; producción en Firebase Secret Manager)
# firebase functions:secrets:set RESEND_API_KEY
# firebase functions:secrets:set FROM_EMAIL
# firebase functions:secrets:set REPLY_TO
# RESEND_API_KEY=re_123456789
# FROM_EMAIL=Calculadora de Márgenes <onboarding@resend.dev>
# REPLY_TO=soporterefillstore@gmail.com

# Opción B: SMTP (Gmail, Brevo, SendGrid, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicación

# Verificación automática Pabilo (producción: configurar los 3 con `firebase functions:secrets:set`)
# PABILO_API_KEY=tu_api_key_de_pabilo
# PABILO_USER_BANK_ID=id_numerico_de_tu_cuenta_bdv_en_pabilo
# PABILO_BINANCE_USER_BANK_ID=id_numerico_de_tu_cuenta_binance_en_pabilo
# PABILO_BASE_URL=https://api.pabilo.app
# Opcionales para Payment Links / Webhook (si no están, `webhookUrl` usa pabiloWebhook y el webhook valida SIEMPRE con GET /paymentlink/{id}/info)
# PABILO_WEBHOOK_URL=https://pabilowebhook-yqgkyclg5a-uc.a.run.app
# PABILO_WEBHOOK_SECRET=opcional_firma_hmac_webhook_pabilo
# PABILO_REDIRECT_URL=https://margencalcu.online/gracias

# Datos públicos opcionales mostrados al usuario si aún no están en Firestore (`config/proPayments`)
# PRO_PM_BANK=Banco de Venezuela (BDV · 0102)
# PRO_PM_CEDULA=31955598
# PRO_PM_PHONE=04220336568
# PRO_PM_HOLDER=
# PRO_USDT_NETWORK=Binance Pay (USDT)
# PRO_BINANCE_PAY_ID=916942742
# PRO_USDT_ADDRESS=
# PRO_SUPPORT_EMAIL=
# PRO_SUPPORT_WHATSAPP=
