import 'package:firebase_core/firebase_core.dart' show FirebaseOptions;
import 'package:flutter/foundation.dart'
    show defaultTargetPlatform, kIsWeb, TargetPlatform;

/// Plantilla de ejemplo para `firebase_options.dart`.
/// Copia este archivo a `lib/firebase_options.dart` y coloca tus credenciales.
class DefaultFirebaseOptions {
  static FirebaseOptions get currentPlatform {
    if (kIsWeb) {
      return android;
    }
    switch (defaultTargetPlatform) {
      case TargetPlatform.android:
        return android;
      default:
        return android;
    }
  }

  static const FirebaseOptions android = FirebaseOptions(
    apiKey: 'TU_API_KEY_DE_FIREBASE',
    appId: '1:123456789000:android:0000000000000000000000',
    messagingSenderId: '123456789000',
    projectId: 'tu-proyecto-firebase',
    storageBucket: 'tu-proyecto-firebase.firebasestorage.app',
  );
}
